# Exemple de configuration d'environnement
# Copier ce fichier vers .env puis adapter les valeurs : cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5433
POSTGRES_DB=postgres

# Utilisateur applicatif & Data Warehouse
DW_ADMIN_USER=admin
DW_ADMIN_PASSWORD=change_me_admin_password
DW_DB_NAME=dwh
OLTP_DB_NAME=ecommerce_oltp
METABASE_DB_NAME=metabase_app

# Apache Hop Web
HOP_PORT=8081
HOP_WEB_ADMIN_USER=admin
HOP_WEB_ADMIN_PASSWORD=change_me_hop_password

# Metabase
METABASE_PORT=3000
TZ=UTC
