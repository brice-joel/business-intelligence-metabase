  <transform>
    <type>TableInput</type>
    <name>staging.stg_orders</name>
    <sql>SELECT
    o.order_id,
    o.order_number,
    TO_CHAR(o.ordered_at, 'YYYYMMDD')::INTEGER AS date_key,
    c.customer_sk,
    COALESCE(pm.payment_method_sk, (SELECT payment_method_sk FROM mart.dim_payment_method WHERE payment_method_code = 'unknown')) AS payment_method_sk,
    o.order_status,
    o.payment_status,
    o.shipping_country,
    o.shipping_city,
    o.carrier,
    o.delivery_days,
    o.subtotal_amount,
    o.discount_amount,
    o.shipping_amount,
    o.total_amount,
    o.refund_amount,
    o.is_returned,
    o.ordered_at
FROM staging.stg_orders o
INNER JOIN mart.dim_customer c ON c.customer_id = o.customer_id
LEFT JOIN mart.dim_payment_method pm ON pm.payment_method_code = o.payment_method</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dwh</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
