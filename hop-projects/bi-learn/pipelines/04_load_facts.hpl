  <transform>
    <type>TableInput</type>
    <name>staging.stg_order_items</name>
    <sql>SELECT
    oi.order_item_id,
    oi.order_id,
    oi.order_number,
    TO_CHAR(oi.ordered_at, 'YYYYMMDD')::INTEGER AS date_key,
    c.customer_sk,
    p.product_sk,
    COALESCE(pm.payment_method_sk, (SELECT payment_method_sk FROM mart.dim_payment_method WHERE payment_method_code = 'unknown')) AS payment_method_sk,
    oi.order_status,
    oi.quantity,
    oi.unit_price,
    oi.unit_cost,
    oi.discount_amount,
    oi.gross_amount,
    oi.net_amount,
    oi.cogs_amount,
    oi.gross_margin_amount,
    oi.ordered_at
FROM staging.stg_order_items oi
INNER JOIN mart.dim_customer c ON c.customer_id = oi.customer_id
INNER JOIN mart.dim_product p ON p.product_id = oi.product_id AND p.is_current = TRUE
LEFT JOIN mart.dim_payment_method pm ON pm.payment_method_code = oi.payment_method</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
